{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "japanese",
  "disableClaudeAiConnectors": true,
  "promptSuggestionEnabled": false,
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read(./**)",
      "mcp__discordbridge__reply",
      "mcp__discordbridge__react",
      "mcp__discordbridge__edit_message",
      "mcp__discordbridge__send_file",
      "mcp__discordbridge__progress"
    ],
    "deny": [
      "Read(~/.claude/channels/**)",
      "Edit(~/.claude/channels/**)",
      "Read(~/.claude.json)",
      "Read(~/.ssh/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(~/.claude/**)",
      "Read(~/.git-credentials)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/AppData/Roaming/GitHub CLI/**)",
      "Read(~/.npmrc)",
      "Read(~/.docker/**)",
      "Edit(./.claude/**)",
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git reset --hard:*)"
    ]
  }
}
