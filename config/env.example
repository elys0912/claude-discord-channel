DISCORD_BOT_TOKEN=
# 任意。書くと download_file ツールが使える（絶対パス）
# DOWNLOAD_DIR=C:\Users\<ユーザー名>\Downloads
# 任意。on にすると実行許可に「このセッション中は全部許可」ボタンが出る
# SESSION_ALLOW_ALL=on
# 任意。テキストの添付（長文を貼ったときの message.txt など）を本文に差し込む 1 ファイルの上限（KB）。既定 100、0 で差し込まない
# INLINE_TEXT_MAX_KB=100
# 任意。書くと send_file ツールが使える。確認なしで送ってよいフォルダー（絶対パスを ; で区切る）。外のファイルは Discord で確認してから送る
# UPLOAD_DIRS=C:\Users\<ユーザー名>\Documents\share
# 任意。送るファイル 1 つの上限（MB）。既定 10（ブーストしていないサーバーと DM の上限）
# UPLOAD_MAX_MB=10
# 任意。これを超える長さの返信は、冒頭だけを本文にして全文を reply.md で添付する。既定 6000、0 で分けて送る
# LONG_REPLY_CHARS=6000
