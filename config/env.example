DISCORD_BOT_TOKEN=
# 任意。書くと download_file ツールが使える（絶対パス）
# DOWNLOAD_DIR=C:\Users\<ユーザー名>\Downloads
# 任意。on にすると実行許可に「このセッション中は全部許可」ボタンが出る
# SESSION_ALLOW_ALL=on
# 任意。テキストの添付（長文を貼ったときの message.txt など）を本文に差し込む 1 ファイルの上限（KB）。既定 100、0 で差し込まない
# INLINE_TEXT_MAX_KB=100
# 任意。書くと send_file ツールが使える。確認なしで送ってよいフォルダー（絶対パスを ; で区切る）。外のファイルは Discord で確認してから送る
# UPLOAD_DIRS=C:\Users\<ユーザー名>\Documents\share
# 任意。送るファイル 1 つの上限（MB）。既定 10（ブーストしていないサーバーと DM の上限）
# UPLOAD_MAX_MB=10
# 任意。これを超える長さの返信は、冒頭だけを本文にして全文を reply.md で添付する。既定 6000、0 で分けて送る
# LONG_REPLY_CHARS=6000
# 任意。キャッシュ（1 時間で切れる）のつなぎ止め。既定 on。最後の応答から KEEPALIVE_AFTER_MIN 分で短い合図を送る
# KEEPALIVE=on
# KEEPALIVE_AFTER_MIN=55
# 最後の会話から送る回数の上限（書き直し 1 回は合図約 20 回ぶん）
# KEEPALIVE_MAX=6
# 送らない時間帯（HH:MM-HH:MM。空なら時間帯なし）
# KEEPALIVE_QUIET=01:00-07:00
# 任意。使用量（5 時間枠・7 日枠）とコンテキストの見張り。既定 on。statusline の記録（usage.json）を読んで知らせる
# USAGE_WATCH=on
# 使用量のしきい値（%、カンマ区切り。空なら知らせない）
# USAGE_WARN_PCT=80,95
# コンテキストのしきい値（%、カンマ区切り。空なら知らせない）
# CONTEXT_WARN_PCT=70,90
# 任意。Claude Code が想定外に終了（exit code が 0 以外）したら、同じ会話で起動し直す（10 分に 3 回まで）。既定 on。start.ps1 が読む
# AUTO_RESTART=on
# 任意。off にすると、TODO の進み具合のカードを出す progress ツールを出さない。既定 on
# TODO_PROGRESS=on
